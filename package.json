{
  "name": "{{ name }}",
  "version": "1.0.0",
  "private": true,
  "description": "{{ description }}",
  "type": "module",
  "scripts": {
    "dev": "node scripts/start.js",
    "build": "node scripts/build.js",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "preview": "vite preview",
    "api:generate": "orval",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:junit": "vitest run --reporter=junit --outputFile=test-results/vitest-junit.xml",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:component-coverage": "node scripts/check-component-tests.js",
    "lint": "oxlint . --vue-plugin --import-plugin --deny-warnings",
    "lint:fix": "oxlint . --vue-plugin --import-plugin --fix",
    "format": "oxfmt . --write",
    "format:check": "oxfmt . --check",
    "preinstall": "npx only-allow pnpm",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@heroicons/vue": "^2.2.0",
    "@lucide/vue": "^1.64.0",
    "@vue/devtools-api": "^8.2.1",
    "@vueuse/core": "^15.0.0",
    "axios": "^1.21.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "ogl": "^1.0.11",
    "pinia": "^4.1.0",
    "pinia-plugin-persistedstate": "^4.7.1",
    "reka-ui": "^2.11.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "vaul-vue": "^0.4.1",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "vue-sonner": "^2.0.9",
    "web-vitals": "^6.2.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@plugin-web-update-notification/vite": "^2.1.3",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/vue": "^8.1.0",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^24.19.2",
    "@vitejs/devtools": "^0.8.0",
    "@vitejs/devtools-kit": "^0.8.0",
    "@vitejs/plugin-legacy": "^8.2.3",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/ui": "^5.0.5",
    "@vue/test-utils": "^2.5.1",
    "autoprefixer": "^10.6.2",
    "code-inspector-plugin": "^2.0.9",
    "jest-axe": "^11.0.0",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "msw": "^3.0.3",
    "orval": "^8.45.0",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "shadcn-vue": "^2.9.0",
    "simple-git-hooks": "^2.14.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vite-plugin-compression2": "^2.5.4",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged",
    "commit-msg": "node scripts/verify-commit.js $1"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,vue}": "oxlint --vue-plugin --import-plugin --fix --no-error-on-unmatched-pattern",
    "*.{js,jsx,ts,tsx,vue,json,jsonc,css,html,md,yml,yaml}": "oxfmt --write --no-error-on-unmatched-pattern"
  },
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1",
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
