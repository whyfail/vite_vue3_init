{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "vue", "import"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "ignorePatterns": [
    "node_modules/**",
    "dist/**",
    "public/**",
    ".agents/**",
    ".trae/**",
    "src/shared/api/generated/**",
    "openapi/**"
  ],
  "env": {
    "builtin": true,
    "browser": true,
    "node": true
  },
  "rules": {
    "import/no-named-as-default-member": "off",
    "import/no-unassigned-import": "off"
  }
}
